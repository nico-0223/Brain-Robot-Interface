# Emotiv Cortex connection
EMOTIV_CORTEX_URL=wss://localhost:6868
EMOTIV_CLIENT_ID=
EMOTIV_CLIENT_SECRET=

# CoderBot HTTP API
CODERBOT_BASE_URL=http://coderbot.local

# Set to true to print CoderBot actions without sending mutating HTTP requests.
DRY_RUN=true

# Movement and experiment settings
CODERBOT_MOVE_SPEED=100
CODERBOT_MOVE_ELAPSE=1
EXPERIMENT_SECONDS=120
